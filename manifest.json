{
  "name": "It is spelled Roblox",
  "description": "Automatically corrects misspellings of Roblox across the web",
  "version": "1.0.3",
  "manifest_version": 3,
  "content_scripts": [{
    "js": ["content.js"],
    "matches": ["https://*/*", "http://*/*"],
    "run_at": "document_end"
  }],
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
